+
+# Pylint doesn't play well with fixtures and dependency injection from pytest
+# pylint: disable=redefined-outer-name
+
+import os
+from pathlib import Path
+
+import pytest
+
+from buildstream._testing import cli  # pylint: disable=unused-import
+from buildstream import _yaml
+
+DATA_DIR = os.path.join(
+    os.path.dirname(os.path.realpath(__file__)), "element_overlay"
+)
+
+
+@pytest.mark.datafiles(DATA_DIR)
+def test_override_element(cli, datafiles):
+    project = str(datafiles)
+
+    result = cli.run(
+        project=project,
+        args=[
+            "show",
+            "--format",
+            "%{vars}%{build-deps}",
+            "variable-junction.bst:hello.bst",
+        ],
+    )
+    result.assert_success()
+    assert "message: target message" in result.output
+    assert "unchanged: value" in result.output
+    assert "variable-junction.bst:original-depend.bst" in result.output
+    assert "variable-junction.bst:new-depend.bst" in result.output
+
+
+@pytest.mark.datafiles(DATA_DIR)
+def test_missing_element(cli, datafiles):
+    project = str(datafiles)
+    result = cli.run(
+        project=project,
+        args=["show", "missing-element-junction.bst:hello.bst"],
+    )
+    assert result.exit_code != 0
+    assert "elements/missing.bst" in result.stderr
+
+
+@pytest.mark.datafiles(DATA_DIR)
+def test_parent_dependency_is_not_visible(cli, datafiles):
+    project = str(datafiles)
+    _yaml.roundtrip_dump(
+        {"kind": "stack"}, os.path.join(project, "elements", "parent-only.bst")
+    )
+    _yaml.roundtrip_dump(
+        {"build-depends": {"(>)": ["parent-only.bst"]}},
+        os.path.join(project, "files", "overrides", "hello.yml"),
+    )
+
+    result = cli.run(
+        project=project,
+        args=["show", "variable-junction.bst:hello.bst"],
+    )
+    assert result.exit_code != 0
+    assert "parent-only.bst" in result.stderr
+    assert "Could not find" in result.stderr
+
+
+@pytest.mark.datafiles(DATA_DIR)
+def test_injected_local_source(cli, datafiles, tmp_path):
+    project = Path(str(datafiles))
+    (project / "files/config.sh").write_text("downstream configuration\n")
+    junction_path = project / "elements/variable-junction.bst"
+    junction = _yaml.roundtrip_load(str(junction_path))
+    junction["sources"].insert(
+        1, {"kind": "local", "path": "files/config.sh", "directory": "files"}
+    )
+    _yaml.roundtrip_dump(junction, str(junction_path))
+    (project / "files/overrides/hello.yml").write_text(
+        "sources:\n  (>):\n  - kind: local\n    path: files/config.sh\n"
+    )
+    # Avoid the upstream source's path: '.', which would also copy the file.
+    (project / "subproject/elements/hello.bst").write_text(
+        "kind: import\nsources: []\n"
+    )
+    checkout = tmp_path / "checkout"
+    result = cli.run(
+        project=str(project),
+        args=[
+            "source",
+            "checkout",
+            "--directory",
+            str(checkout),
+            "variable-junction.bst:hello.bst",
+        ],
+    )
+    result.assert_success()
+    assert (checkout / "variable-junction/hello/config.sh").read_text() == (
+        "downstream configuration\n"
+    )
+
+
+@pytest.mark.datafiles(DATA_DIR)
+def test_downstream_dependency_slot(cli, datafiles):
+    project = Path(str(datafiles))
+    (project / "elements/parent-only.bst").write_text("kind: stack\n")
+    junction_path = project / "elements/variable-junction.bst"
+    junction = _yaml.roundtrip_load(str(junction_path))
+    junction["sources"][-1]["dependency-slots"] = ["elements/downstream.bst"]
+    junction["config"] = {"overrides": {"downstream.bst": "parent-only.bst"}}
+    _yaml.roundtrip_dump(junction, str(junction_path))
+    (project / "files/overrides/hello.yml").write_text(
+        "build-depends:\n  (>):\n  - downstream.bst\n"
+    )
+    result = cli.run(
+        project=str(project),
+        args=[
+            "show",
+            "--deps",
+            "all",
+            "--format",
+            "%{name}",
+            "variable-junction.bst:hello.bst",
+        ],
+    )
+    result.assert_success()
+    assert "parent-only.bst" in result.output.splitlines()
+
+
+@pytest.mark.parametrize(
+    "slot, error",
+    [
+        ("../escape.bst", "Dependency slot must be a relative staged path"),
+        ("/tmp/escape.bst", "Dependency slot must be a relative staged path"),
+        ("elements/hello.bst", "Dependency slot already exists"),
+    ],
+)
+@pytest.mark.datafiles(DATA_DIR)
+def test_invalid_dependency_slot(cli, datafiles, slot, error):
+    project = str(datafiles)
+    junction_path = os.path.join(project, "elements", "variable-junction.bst")
+    junction = _yaml.roundtrip_load(junction_path)
+    junction["sources"][-1]["dependency-slots"] = [slot]
+    _yaml.roundtrip_dump(junction, junction_path)
+    result = cli.run(
+        project=project,
+        args=["show", "variable-junction.bst:hello.bst"],
+    )
+    assert result.exit_code != 0
+    assert error in result.stderr
